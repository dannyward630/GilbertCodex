{
  "name": "gilbert-codex",
  "version": "0.2.2",
  "description": "GUI-first local desktop agent workspace built with React, Tauri, and Rust.",
  "license": "MIT",
  "type": "module",
  "author": "Gilbert Codex Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UrbanWafflezz/GilbertCodex.git"
  },
  "bugs": {
    "url": "https://github.com/UrbanWafflezz/GilbertCodex/issues"
  },
  "homepage": "https://github.com/UrbanWafflezz/GilbertCodex#readme",
  "keywords": [
    "agent",
    "desktop",
    "react",
    "tauri",
    "workspace"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run build && npm run rust:fmt:check && npm run rust:check",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "installer:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-installer-assets.ps1",
    "app:installer": "npm run installer:assets && tauri build --bundles nsis",
    "app:release": "npm run installer:assets && tauri build --bundles nsis --config src-tauri/tauri.updater.conf.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "color-name-list": "^14.36.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
