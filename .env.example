# Optional public project-funding links for local development builds.
# These must be hosted URLs that are safe to share with every app user.
# Do not put Stripe secret keys, webhook secrets, API keys, access tokens,
# OAuth credentials, or private account data in Vite environment values.
# Leave Cash App blank to use the public project default from supportConfig.
VITE_SUPPORT_STRIPE_ONE_TIME_URL=
VITE_SUPPORT_STRIPE_MONTHLY_URL=
VITE_SUPPORT_PAYPAL_URL=
VITE_SUPPORT_CASHAPP_URL=
