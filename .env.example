# Public GitHub OAuth App client ID for browser/device-flow login.
# Gilbert Codex requests full GitHub OAuth access at sign-in so repository,
# workflow, package, gist, organization, and admin-capable source-control tools can work.
VITE_GITHUB_OAUTH_CLIENT_ID=

# Public Google OAuth desktop-client ID for Gmail sign-in.
# End users only click Apps > Gmail > Install Gmail. Developers set this once
# for local/dev builds. Official release builds read this from the GitHub
# repository variable or secret with the same name.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Backend-only Google OAuth desktop-client secret for Gmail token exchange.
# Keep this in ignored local .env files or GitHub release secrets only. Do not
# expose it through VITE values or commit a real value to source control.
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional public project-funding links. These must be hosted URLs that are safe to
# share with every app user. Do not put Stripe secret keys, webhook secrets,
# API keys, access tokens, or private account data in Vite environment values.
VITE_SUPPORT_STRIPE_ONE_TIME_URL=
VITE_SUPPORT_STRIPE_MONTHLY_URL=
VITE_SUPPORT_PAYPAL_URL=
VITE_SUPPORT_CASHAPP_URL=https://cash.app/$kobeelijahhh
