{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gilbert Codex",
  "version": "0.0.2",
  "identifier": "com.gilbert.codex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gilbert Codex",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* http://0.0.0.0:* ws://localhost:* ws://127.0.0.1:*",
        "font-src": "'self' data:",
        "frame-src": "http: https:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0RTNDQkJCN0JENTY1NjgKUldSb1pkVjd1OHZqSkp4aGo3RDVsdlRSdHlsRkI3MGFRMXJ3V0NXdzlYejdmdjl0UHB1Vk1vVE8K",
      "endpoints": [
        "https://github.com/UrbanWafflezz/GilbertCodex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
