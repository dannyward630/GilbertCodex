{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gilbert Codex",
  "version": "0.1.0",
  "identifier": "com.gilbert.codex",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gilbert Codex",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
